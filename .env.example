# Copy to .env (gitignored) and fill in.

# Access token for the dashboard, the API and /mcp. Use a long random value:
#   openssl rand -base64 24
SIEM_TOKEN=

# Optional: the triage agent (Claude). Without it, triage runs as a fixed playbook.
ANTHROPIC_API_KEY=

# Optional: Pepper, the voice security engineer (OpenAI GPT-Live).
OPENAI_API_KEY=

# Event pipeline (set by docker compose; for a local run use nats://localhost:4222)
NATS_URL=nats://localhost:4222
